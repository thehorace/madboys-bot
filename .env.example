# ---- required ----
DISCORD_TOKEN=your-bot-token
MIDDLEWARE_URL=https://your-tunnel.trycloudflare.com

# ---- strongly recommended ----
GUILD_ID=123456789012345678           # your server ID: instant command sync + tells the tracker where to post
DB_PATH=/data/madboys.db              # on Railway, put this inside a mounted Volume or it's wiped every deploy

# ---- optional ----
MIDDLEWARE_API_KEY=
CLUB_NAME=MADBOYS FC
CLUB_ID=85077
EA_PLATFORM=common-gen5
MATCH_TYPES=leagueMatch,playoffMatch
MATCHDAY_CHANNEL_ID=                  # or just run /matchday start in the channel
POLL_ACTIVE_MINUTES=2
POLL_IDLE_MINUTES=10
ACTIVE_WINDOW_MINUTES=90
BOT_TZ=Asia/Singapore
RECAP_WEEKDAY=6                       # 0=Mon ... 6=Sun
RECAP_HOUR=21
ROTATION_THRESHOLD=3
BUILDS_URL=
